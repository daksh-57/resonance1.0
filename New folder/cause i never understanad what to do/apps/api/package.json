    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.1",
    "papaparse": "^5.5.2",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "xlsx": "^0.18.5",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/supertest": "^6.0.3",
