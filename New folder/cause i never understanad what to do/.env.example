# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://reconcile:reconcile@localhost:5432/reconcile
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# --- File storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# --- Reconciliation thresholds (0..1) ---
MATCH_AUTO_THRESHOLD=0.90
MATCH_REVIEW_THRESHOLD=0.70
AUTO_RESOLVE_THRESHOLD=0.85

# --- Normalization ---
DEFAULT_COUNTRY_CODE=+1

# --- Optional LLM (never required; engine falls back to deterministic mode) ---
LLM_PROVIDER=none
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# --- Optional SMTP for password-reset emails (dev mode surfaces the link in the API response instead) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
